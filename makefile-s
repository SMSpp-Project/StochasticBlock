##############################################################################
################################ makefile-s ##################################
##############################################################################
#                                                                            #
#   makefile of StochasticBlock and its dependencies, excluding SMS++        #
#                                                                            #
#   The makefile defines internally all external libraries required by       #
#   StochasticBlock, excluding the SMS++ core ones whose symbols are         #
#   assumed to have been defined already (typically by including             #
#   SMS++/lib/makefile). Accordingly, all necessary OBJ, H, -I directives,   #
#   external libraries  + -L< libdirs > are added to the corresponding       #
#   StcBlk* macros.                                                          #
#                                                                            #
#   Input:  $(CC)         = compiler command                                 #
#           $(SW)         = compiler options                                 #
#           $(SMS++INC)   = the -I$( core SMS++ directory )                  #
#           $(SMS++OBJ)   = the core SMS++ library                           #
#           $(StcBlkSDR)  = the directory where StcBlkBlock source is        #
#                                                                            #
#   Output: $(StcBlkOBJ) = the final object(s) / library                     #
#           $(StcBlkLIB) = external libraries + -L< libdirs >                #
#           $(StcBlkH)   = the .h files to include for StochasticBlock       #
#           $(StcBlkINC) = the -I$( StochasticBlock directory )              #
#                                                                            #
#                              Antonio Frangioni                             #
#                         Dipartimento di Informatica                        #
#                             Universita' di Pisa                            #
#                                                                            #
##############################################################################

# define & include the necessary modules- - - - - - - - - - - - - - - - - - -
# if a module is not used in the current configuration, just comment out the
# corresponding include line
# each module outputs some macros to be used here:
# *OBJ is the final object/library
# *H   is the list of all include files
# *INC is the -I< include directories >

# define input macros for CapacitatedFacilityLocationBlock makefile +
# dependencies (excluding core SMS++), then include it
CFLBkSDR = $(StcBlkSDR)/../CapacitatedFacilityLocationBlock
include $(CFLBkSDR)/makefile-s

# include the makefile requiring all external modules in input
include $(StcBlkSDR)/makefile

# macros to be exported - - - - - - - - - - - - - - - - - - - - - - - - - - -

# append external -I directives to StcBlkBINC, StcBlkBOBJ and StcBlkBH as
# defined by the makefile, thus the := assignment has to be used
StcBlkOBJ := $(StcBlkOBJ) $(CFLBkOBJ)
StcBlkH := $(StcBlkH) $(CFLBkH)
StcBlkINC := $(CFLBkINC) $(StcBlkINC)

# external libraries for StochasticBlock
StcBlkLIB = $(CFLBkLIB)

########################### End of makefile-s ################################
